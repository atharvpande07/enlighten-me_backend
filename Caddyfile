# Caddy Reverse Proxy Configuration for Enlighten Me API
# Automatic TLS renewal via Let's Encrypt with explicit 120-second timeout boundaries

{$DOMAIN:api.enlightenme.app} {
    # Logging
    log {
        output stdout
        format console
        level INFO
    }

    # Security Headers
    header {
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Clickjacking defense
        X-Frame-Options "DENY"
        # Strict Transport Security (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Remove server identification header
        -Server
    }

    # Compress textual responses
    encode gzip zstd

    # Reverse Proxy to FastAPI Backend with 120s timeout boundary
    reverse_proxy backend:8000 {
        # Transport settings to prevent dropping 60-min audio inference loops
        transport http {
            read_timeout 120s
            write_timeout 120s
            dial_timeout 10s
            keepalive 120s
        }

        # Health monitoring
        health_uri /api/v1/health
        health_interval 15s
        health_timeout 5s
    }
}
