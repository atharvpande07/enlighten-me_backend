# Server Configuration
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_JWT_SECRET=super-secret-jwt-token-key-for-local-testing-only

# AI Vendor API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# RevenueCat Webhook Security
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret_key_here

# Routing & Guards
MAX_AUDIO_BYTES=24000000
ROUTER_TIMEOUT_SECONDS=120
